{
  "name": "My Python Codespace",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.10-bookworm",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy"
      ],
      "settings": {
        "editor.fontSize": 16,
        "editor.formatOnSave": true,
        "editor.minimap.enabled": false
      }
    }
  }
}